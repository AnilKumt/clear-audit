datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Firm {
  id          String       @id @default(cuid())
  name        String
  users       User[]
  clients     Client[]
  documents   Document[]
  auditEvents AuditEvent[]
  createdAt   DateTime     @default(now())
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         Role              // STAFF | REVIEWER | PARTNER
  firmId       String
  firm         Firm              @relation(fields: [firmId], references: [id])
  versions     DocumentVersion[]
  auditEvents  AuditEvent[]
  createdAt    DateTime          @default(now())

  @@index([firmId])
}

enum Role {
  STAFF
  REVIEWER
  PARTNER
}

model Client {
  id        String     @id @default(cuid())
  name      String
  firmId    String
  firm      Firm       @relation(fields: [firmId], references: [id])
  documents Document[]
  createdAt DateTime   @default(now())

  @@index([firmId])
}

model Document {
  id            String            @id @default(cuid())
  name          String            // e.g. "Bank Statement", "GST Return"
  status        DocumentStatus    @default(PENDING)
  clientId      String
  client        Client            @relation(fields: [clientId], references: [id])
  firmId        String            // denormalized for fast/safe scoping
  firm          Firm              @relation(fields: [firmId], references: [id])
  versions      DocumentVersion[]
  auditEvents   AuditEvent[]
  reviewComment String?           // latest correction-request reason, nullable
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([firmId])
}

enum DocumentStatus {
  PENDING
  UPLOADED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPROVED
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id])
  versionNumber Int
  fileName      String
  fileData      String   // base64
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime @default(now())
}

model AuditEvent {
  id         String      @id @default(cuid())
  firmId     String      // for isolation on the audit feed too
  firm       Firm        @relation(fields: [firmId], references: [id])
  documentId String
  document   Document    @relation(fields: [documentId], references: [id])
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id])
  action     AuditAction
  comment    String?
  createdAt  DateTime    @default(now())

  @@index([firmId])
}

enum AuditAction {
  CLIENT_CREATED
  DOCUMENT_REQUIREMENT_ADDED
  DOCUMENT_UPLOADED
  REVIEW_STARTED
  CORRECTION_REQUESTED
  DOCUMENT_APPROVED
}
